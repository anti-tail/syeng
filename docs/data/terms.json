[{"t":"音韻學","py":"yīnyùnxué","cat":"總論","def":"研究漢語歷代語音系統及其演變的學科，傳統小學之一。"},{"t":"上古音","py":"shànggǔyīn","cat":"總論","def":"以《詩經》押韻、諧聲字等爲主要依據的先秦兩漢漢語語音。"},{"t":"中古音","py":"zhōnggǔyīn","cat":"總論","def":"以《切韻》系韻書和早期韻圖爲代表的隋唐漢語語音。"},{"t":"近代音","py":"jìndàiyīn","cat":"總論","def":"以《中原音韻》等爲代表的元明清漢語語音。"},{"t":"古音學","py":"gǔyīnxué","cat":"總論","def":"專門研究上古音的學問。"},{"t":"今音學","py":"jīnyīnxué","cat":"總論","def":"研究《切韻》音系的學問。"},{"t":"等韻學","py":"děngyùnxué","cat":"總論","def":"研究韻圖、分析字音結構的學問。"},{"t":"擬音","py":"nǐyīn","cat":"總論","def":"對古代讀音所作的語音構擬，常加星號 * 表示。"},{"t":"構擬","py":"gòunǐ","cat":"總論","def":"用比較法、內部擬測等方法推定古代語音形式。"},{"t":"切韻","py":"Qièyùn","cat":"文獻","def":"隋陸法言等編撰（601 年成書）的韻書，中古音研究的基礎。"},{"t":"廣韻","py":"Guǎngyùn","cat":"文獻","def":"宋陳彭年等重修的《大宋重修廣韻》（1008 年），分 206 韻。"},{"t":"集韻","py":"Jíyùn","cat":"文獻","def":"宋丁度等編（1039 年），收字多於《廣韻》。"},{"t":"韻鏡","py":"Yùnjìng","cat":"文獻","def":"現存最早的韻圖之一，分 43 轉。"},{"t":"七音略","py":"Qīyīnlüè","cat":"文獻","def":"鄭樵《通志》所收韻圖，分 43 轉。"},{"t":"切韻指掌圖","py":"Qièyùn Zhǐzhǎngtú","cat":"文獻","def":"宋代韻圖，分 20 圖。"},{"t":"經典釋文","py":"Jīngdiǎn Shìwén","cat":"文獻","def":"陸德明所撰，大量反切注音，是中古音的重要資料。"},{"t":"說文解字","py":"Shuōwén Jiězì","cat":"文獻","def":"許慎所撰字書，所記形聲結構是諧聲分析的基礎。"},{"t":"詩經","py":"Shījīng","cat":"文獻","def":"先秦詩歌總集，其押韻是上古韻部的主要依據。"},{"t":"聲母","py":"shēngmǔ","cat":"聲母","def":"音節開頭的輔音。"},{"t":"韻母","py":"yùnmǔ","cat":"韻母","def":"音節中聲母以後的部分，含介音、主元音、韻尾。"},{"t":"聲調","py":"shēngdiào","cat":"聲調","def":"具有區別意義作用的音高變化。"},{"t":"聲紐","py":"shēngniǔ","cat":"聲母","def":"傳統稱聲母，又稱「紐」。"},{"t":"字母","py":"zìmǔ","cat":"聲母","def":"以代表字標示聲母，如三十六字母。"},{"t":"三十六字母","py":"sānshíliù zìmǔ","cat":"聲母","def":"唐宋時代以三十六個代表字表示的聲母系統。"},{"t":"守溫字母","py":"Shǒuwēn zìmǔ","cat":"聲母","def":"傳爲唐末僧守溫所定的三十字母。"},{"t":"五音","py":"wǔyīn","cat":"聲母","def":"按發音部位分聲母爲脣、舌、齒、牙、喉五類。"},{"t":"七音","py":"qīyīn","cat":"聲母","def":"五音加半舌、半齒。"},{"t":"脣音","py":"chúnyīn","cat":"聲母","def":"雙脣及脣齒音：幫滂並明、非敷奉微。"},{"t":"重脣音","py":"zhòngchúnyīn","cat":"聲母","def":"雙脣音幫滂並明。"},{"t":"輕脣音","py":"qīngchúnyīn","cat":"聲母","def":"脣齒音非敷奉微，由重脣在三等合口條件下分化而來。"},{"t":"舌音","py":"shéyīn","cat":"聲母","def":"舌頭音與舌上音。"},{"t":"舌頭音","py":"shétóuyīn","cat":"聲母","def":"端透定泥。"},{"t":"舌上音","py":"shéshàngyīn","cat":"聲母","def":"知徹澄孃。"},{"t":"齒音","py":"chǐyīn","cat":"聲母","def":"齒頭音與正齒音。"},{"t":"齒頭音","py":"chǐtóuyīn","cat":"聲母","def":"精清從心邪。"},{"t":"正齒音","py":"zhèngchǐyīn","cat":"聲母","def":"照穿牀審禪，又分莊組（照二）與章組（照三）。"},{"t":"牙音","py":"yáyīn","cat":"聲母","def":"見溪羣疑。"},{"t":"喉音","py":"hóuyīn","cat":"聲母","def":"影曉匣喻。"},{"t":"半舌音","py":"bànshéyīn","cat":"聲母","def":"來母。"},{"t":"半齒音","py":"bànchǐyīn","cat":"聲母","def":"日母。"},{"t":"清濁","py":"qīngzhuó","cat":"聲母","def":"按聲帶振動與送氣分聲母的四類。"},{"t":"全清","py":"quánqīng","cat":"聲母","def":"不送氣清塞音、塞擦音及清擦音，如幫端見精心。"},{"t":"次清","py":"cìqīng","cat":"聲母","def":"送氣清塞音、塞擦音，如滂透溪清。"},{"t":"全濁","py":"quánzhuó","cat":"聲母","def":"濁塞音、塞擦音、擦音，如並定羣從邪匣。"},{"t":"次濁","py":"cìzhuó","cat":"聲母","def":"鼻音、邊音、半元音等響音，如明泥疑來日以云。"},{"t":"介音","py":"jièyīn","cat":"韻母","def":"聲母與主元音之間的過渡音，如 -i-、-u-。"},{"t":"主元音","py":"zhǔyuányīn","cat":"韻母","def":"韻母中的核心元音，又稱韻腹。"},{"t":"韻腹","py":"yùnfù","cat":"韻母","def":"即主元音。"},{"t":"韻尾","py":"yùnwěi","cat":"韻母","def":"韻母末尾的輔音或元音。"},{"t":"韻頭","py":"yùntóu","cat":"韻母","def":"即介音。"},{"t":"陰聲韻","py":"yīnshēngyùn","cat":"韻母","def":"無韻尾或以元音收尾的韻。"},{"t":"陽聲韻","py":"yángshēngyùn","cat":"韻母","def":"以鼻音 -m、-n、-ŋ 收尾的韻。"},{"t":"入聲韻","py":"rùshēngyùn","cat":"韻母","def":"以塞音 -p、-t、-k 收尾的韻。"},{"t":"陰陽對轉","py":"yīnyáng duìzhuǎn","cat":"韻母","def":"主元音相同的陰聲韻、陽聲韻（及入聲韻）之間的相互轉化或通假。"},{"t":"對轉","py":"duìzhuǎn","cat":"韻母","def":"主元音相同而韻尾類型不同的韻部之間的交替。"},{"t":"旁轉","py":"pángzhuǎn","cat":"韻母","def":"韻尾類型相同而主元音相近的韻部之間的交替。"},{"t":"通轉","py":"tōngzhuǎn","cat":"韻母","def":"韻部之間較遠的通押或交替的泛稱。"},{"t":"韻","py":"yùn","cat":"韻母","def":"韻書中押韻的單位；《廣韻》分 206 韻。"},{"t":"韻目","py":"yùnmù","cat":"韻母","def":"每個韻的代表字，如東、董、送、屋。"},{"t":"韻部","py":"yùnbù","cat":"韻母","def":"上古押韻歸納出的類，如之部、魚部。"},{"t":"韻系","py":"yùnxì","cat":"韻母","def":"平上去入相承的一組韻，如東董送屋。"},{"t":"韻類","py":"yùnlèi","cat":"韻母","def":"依反切下字系聯所得的韻母類別。"},{"t":"攝","py":"shè","cat":"韻圖","def":"韻圖中把韻尾相同、主元音相近的韻歸併成的大類，共十六攝。"},{"t":"十六攝","py":"shíliù shè","cat":"韻圖","def":"通江止遇蟹臻山效果假宕梗曾流深咸。"},{"t":"等","py":"děng","cat":"韻圖","def":"韻圖按韻母洪細分爲一二三四等。"},{"t":"等呼","py":"děnghū","cat":"韻圖","def":"等與開合口的合稱。"},{"t":"開口","py":"kāikǒu","cat":"韻圖","def":"無 -u- 介音或圓脣成分的韻母。"},{"t":"合口","py":"hékǒu","cat":"韻圖","def":"有 -u- 介音或圓脣成分的韻母。"},{"t":"開合","py":"kāihé","cat":"韻圖","def":"開口與合口。"},{"t":"轉","py":"zhuǎn","cat":"韻圖","def":"《韻鏡》《七音略》中韻圖的單位，一轉即一張圖。"},{"t":"內轉","py":"nèizhuǎn","cat":"韻圖","def":"韻圖中二等位置無獨立韻的轉。"},{"t":"外轉","py":"wàizhuǎn","cat":"韻圖","def":"韻圖中二等位置有獨立韻的轉。"},{"t":"重紐","py":"chóngniǔ","cat":"韻圖","def":"支脂祭真仙宵侵鹽等韻的脣牙喉音分兩類，韻圖分置三等、四等。"},{"t":"重紐三等","py":"chóngniǔ sānděng","cat":"韻圖","def":"即 B 類，韻圖列於三等。"},{"t":"重紐四等","py":"chóngniǔ sìděng","cat":"韻圖","def":"即 A 類，韻圖列於四等。"},{"t":"假四等","py":"jiǎ sìděng","cat":"韻圖","def":"實屬三等而韻圖借四等位置排列的字，如精組、以母三等字。"},{"t":"假二等","py":"jiǎ èrděng","cat":"韻圖","def":"實屬三等而韻圖借二等位置排列的莊組字。"},{"t":"平聲","py":"píngshēng","cat":"聲調","def":"中古四聲之一。"},{"t":"上聲","py":"shǎngshēng","cat":"聲調","def":"中古四聲之一，「上」讀 shǎng。"},{"t":"去聲","py":"qùshēng","cat":"聲調","def":"中古四聲之一。"},{"t":"入聲","py":"rùshēng","cat":"聲調","def":"中古四聲之一，以 -p、-t、-k 收尾。"},{"t":"四聲","py":"sìshēng","cat":"聲調","def":"平上去入。"},{"t":"四聲相承","py":"sìshēng xiāngchéng","cat":"聲調","def":"同一韻系的平上去入各韻相互配合。"},{"t":"平仄","py":"píngzè","cat":"聲調","def":"平聲與上去入（仄聲）之分。"},{"t":"反切","py":"fǎnqiè","cat":"注音","def":"用兩字拼一字之音：上字取聲母，下字取韻母和聲調。"},{"t":"反切上字","py":"fǎnqiè shàngzì","cat":"注音","def":"反切的第一字，表聲母。"},{"t":"反切下字","py":"fǎnqiè xiàzì","cat":"注音","def":"反切的第二字，表韻母與聲調。"},{"t":"小韻","py":"xiǎoyùn","cat":"注音","def":"韻書中同音字組，以首字爲代表並注反切。"},{"t":"直音","py":"zhíyīn","cat":"注音","def":"以同音字注音的方法。"},{"t":"讀若","py":"dúruò","cat":"注音","def":"漢代注音術語，以音近字比況。"},{"t":"系聯法","py":"xìliánfǎ","cat":"方法","def":"陳澧用以歸納反切上下字類別的方法。"},{"t":"諧聲","py":"xiéshēng","cat":"方法","def":"形聲字與其聲符之間的語音關係。"},{"t":"聲符","py":"shēngfú","cat":"方法","def":"形聲字中表音的部分。"},{"t":"諧聲系列","py":"xiéshēng xìliè","cat":"方法","def":"同一聲符的一組形聲字。"},{"t":"同源詞","py":"tóngyuáncí","cat":"方法","def":"音義相關、出自同一詞根的詞。"},{"t":"通假","py":"tōngjiǎ","cat":"方法","def":"借用音同音近的字表示本字。"},{"t":"押韻","py":"yāyùn","cat":"方法","def":"詩文句末用韻相同的字。"},{"t":"合韻","py":"héyùn","cat":"方法","def":"不同韻部的字偶爾相押。"},{"t":"古無輕脣音","py":"gǔ wú qīngchúnyīn","cat":"學說","def":"錢大昕：上古沒有輕脣音，非敷奉微讀如幫滂並明。"},{"t":"古無舌上音","py":"gǔ wú shéshàngyīn","cat":"學說","def":"錢大昕：上古沒有舌上音，知徹澄讀如端透定。"},{"t":"娘日歸泥","py":"niáng rì guī ní","cat":"學說","def":"章炳麟：上古娘母、日母歸泥母。"},{"t":"喻三歸匣","py":"yù sān guī xiá","cat":"學說","def":"曾運乾：喻母三等（云母）上古歸匣母。"},{"t":"喻四歸定","py":"yù sì guī dìng","cat":"學說","def":"曾運乾：喻母四等（以母）上古與定母相近。"},{"t":"照二歸精","py":"zhào èr guī jīng","cat":"學說","def":"黃侃：莊組上古歸精組。"},{"t":"照三歸端","py":"zhào sān guī duān","cat":"學說","def":"章組上古多與端組諧聲，故有此說（說法不一）。"},{"t":"古無去聲","py":"gǔ wú qùshēng","cat":"學說","def":"段玉裁：上古無去聲。"},{"t":"古無上去","py":"gǔ wú shǎng qù","cat":"學說","def":"黃侃：上古只有平、入二聲（有爭議）。"},{"t":"同聲必同部","py":"tóng shēng bì tóng bù","cat":"學說","def":"段玉裁：同聲符的字上古必屬同一韻部。"},{"t":"長入","py":"chángrù","cat":"學說","def":"王力：上古入聲有長短，長入後變去聲。"},{"t":"六元音系統","py":"liù yuányīn xìtǒng","cat":"學說","def":"認爲上古有 *i *e *a *o *u *ə（或 *ɯ）六個元音的學說。"},{"t":"咽化","py":"yānhuà","cat":"學說","def":"白一平、沙加爾以咽化聲母 *Cˤ 解釋中古非三等字。"},{"t":"A型音節","py":"A xíng yīnjié","cat":"學說","def":"白—沙體系中帶咽化的音節，中古多變一二四等。"},{"t":"B型音節","py":"B xíng yīnjié","cat":"學說","def":"白—沙體系中不帶咽化的音節，中古變三等。"},{"t":"長短元音","py":"chángduǎn yuányīn","cat":"學說","def":"鄭張尚芳、潘悟雲以長元音解釋中古一二四等、短元音解釋三等。"},{"t":"墊介音","py":"diànjièyīn","cat":"學說","def":"鄭張體系中的 -r-、-l-、-j- 等介音。"},{"t":"前綴","py":"qiánzhuì","cat":"學說","def":"上古詞頭，如 *s-、*m-、*N-、*k-、*t-。"},{"t":"後綴","py":"hòuzhuì","cat":"學說","def":"上古詞尾，如 *-s、*-ʔ。"},{"t":"次要音節","py":"cìyào yīnjié","cat":"學說","def":"白—沙體系中主音節前的弱化音節，如 *Cə.。"},{"t":"清鼻音","py":"qīngbíyīn","cat":"學說","def":"上古清響音 *m̥ *n̥ *ŋ̊ 等，中古變曉、透等清聲母。"},{"t":"複輔音","py":"fùfǔyīn","cat":"學說","def":"上古聲母中的輔音叢，如 *kr-、*pl-。"},{"t":"聲調起源","py":"shēngdiào qǐyuán","cat":"學說","def":"奧德里古爾：上聲源於 *-ʔ，去聲源於 *-s。"},{"t":"白一平","py":"Bái Yīpíng","cat":"學者","def":"William H. Baxter。"},{"t":"沙加爾","py":"Shā Jiā'ěr","cat":"學者","def":"Laurent Sagart。"},{"t":"鄭張尚芳","py":"Zhèngzhāng Shàngfāng","cat":"學者","def":"《上古音系》作者。"},{"t":"潘悟雲","py":"Pān Wùyún","cat":"學者","def":"上古音研究者。"},{"t":"王力","py":"Wáng Lì","cat":"學者","def":"《漢語史稿》《詩經韻讀》作者，上古三十韻部。"},{"t":"高本漢","py":"Gāo Běnhàn","cat":"學者","def":"Bernhard Karlgren。"},{"t":"李方桂","py":"Lǐ Fāngguì","cat":"學者","def":"《上古音研究》作者。"},{"t":"董同龢","py":"Dǒng Tónghé","cat":"學者","def":"《上古音韻表稿》作者。"},{"t":"陸法言","py":"Lù Fǎyán","cat":"學者","def":"《切韻》編者。"},{"t":"陳澧","py":"Chén Lǐ","cat":"學者","def":"《切韻考》作者，創系聯法。"},{"t":"錢大昕","py":"Qián Dàxīn","cat":"學者","def":"清代學者，提出古無輕脣音、古無舌上音。"},{"t":"段玉裁","py":"Duàn Yùcái","cat":"學者","def":"《說文解字注》《六書音均表》作者。"}]